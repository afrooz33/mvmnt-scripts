<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Donation Receipt</title>
    <style>
      /* Basic styling for demonstration. Tailor to your branding. */
      body {
        font-family: Arial, sans-serif;
        color: #333;
        margin: 0;
        padding: 0;
        background: #f9f9f9;
      }
      .receipt-container {
        max-width: 600px;
        margin: 20px auto;
        background: #ffffff;
        border-radius: 6px;
        padding: 20px;
      }
      .header-section, .footer-section {
        text-align: center;
        margin-bottom: 20px;
      }
      .section-title {
        font-size: 1.2em;
        margin-bottom: 10px;
        font-weight: bold;
      }
      .info-row {
        margin-bottom: 6px;
      }
      .info-label {
        font-weight: bold;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th, td {
        text-align: left;
        padding: 8px;
      }
      th {
        background: #eee;
      }
      .deal-image {
        max-width: 80px;
        max-height: 80px;
        object-fit: contain;
      }
      .subtotal-section {
        margin-top: 15px;
      }
      .subtotal-section table td {
        border-top: 1px solid #ddd;
      }
      .highlight {
        font-weight: bold;
      }
      .nonprofit-section {
        margin-top: 15px;
        padding: 10px;
        background: #f1f1f1;
        border-radius: 4px;
      }
      .gray-text {
        color: #555;
      }
    </style>
  </head>
  <body>
    <div class="receipt-container">
      <div class="header-section">
        <h2>Donation Receipt</h2>
      </div>
      
      <!-- Date of the donation / purchase -->
      <div class="info-row">
        <span class="info-label">Donation Date:</span>
        <%= data.data_created ? new Date(data.data_created).toLocaleString() : 'N/A' %>
      </div>

      <!-- Show total donation -->
      <div class="info-row">
        <span class="info-label">Total Donation Amount:</span>
        <%= data.total_donation %>
      </div>
      
      <!-- Payment info -->
      <% if (data.payment_info) { %>
        <div class="info-row">
          <span class="info-label">Payment Method:</span> 
          <%= data.payment_info.name %> (<%= data.payment_info.address %>)
        </div>
      <% } %>
      
      <!-- Donation Project or Nonprofit -->
      <% 
         let isNonprofit = data.donation_project && data.donation_project.status === 'DEFAULT';
      %>
      <% if (isNonprofit) { %>
        <div class="nonprofit-section">
          <div class="info-row section-title">Donation made to Nonprofit:</div>
          <% if (data.donation_project && data.donation_project.profile) { %>
            <div class="info-row">
              <span class="info-label">Foundation Name:</span> 
              <%= data.donation_project.profile.foundation_name %>
            </div>
            <div class="info-row">
              <span class="info-label">Foundation URL:</span> 
              <a href="<%= data.donation_project.profile.foundation_url %>">
                <%= data.donation_project.profile.foundation_url %>
              </a>
            </div>
            <% if (data.donation_project.profile.profile_image) { %>
              <div class="info-row">
                <span class="info-label">Profile Image:</span> 
                <img 
                  src="<%= data.donation_project.profile.profile_image.url %>"
                  alt="Nonprofit Profile"
                  style="max-width: 100px; max-height: 100px;"
                />
              </div>
            <% } %>
          <% } else { %>
            <div class="info-row gray-text">No nonprofit details available.</div>
          <% } %>
        </div>
      <% } else { %>
        <!-- If not 'DEFAULT', treat it as a standard donation project -->
        <div class="nonprofit-section">
          <div class="info-row section-title">Donation Project:</div>
          <% if (data.donation_project) { %>
            <div class="info-row">
              <span class="info-label">Project Name:</span> 
              <%= data.donation_project.name %>
            </div>
            <div class="info-row">
              <span class="info-label">Project ID:</span> 
              <%= data.donation_project.id %>
            </div>
            <% if (data.donation_project.profile) { %>
              <div class="info-row">
                <span class="info-label">Foundation Name:</span>
                <%= data.donation_project.profile.foundation_name %>
              </div>
              <div class="info-row">
                <span class="info-label">Foundation URL:</span>
                <a href="<%= data.donation_project.profile.foundation_url %>">
                  <%= data.donation_project.profile.foundation_url %>
                </a>
              </div>
              <% if (data.donation_project.profile.profile_image) { %>
                <div class="info-row">
                  <span class="info-label">Project Image:</span> 
                  <img 
                    src="<%= data.donation_project.profile.profile_image.url %>"
                    alt="Project Image"
                    style="max-width: 100px; max-height: 100px;"
                  />
                </div>
              <% } %>
            <% } %>
          <% } else { %>
            <div class="info-row gray-text">No project details available.</div>
          <% } %>
        </div>
      <% } %>
      
      <!-- If data_reason === 'BUYNOW', we might have multiple items in source_info -->
      <% if (data.data_reason === 'BUYNOW') { %>
        <div class="section-title">Purchased Items</div>
        
        <% if (Array.isArray(data.source_info) && data.source_info.length > 0) { %>
          <table border="0">
            <thead>
              <tr>
                <th>Item Name</th>
                <th>Images</th>
                <th>Price</th>
              </tr>
            </thead>
            <tbody>
              <% data.source_info.forEach((item) => { %>
                <% const variant = item.variant || {}; %>
                <tr>
                  <td><%= item.name %></td>
                  <td>
                    <% if (variant.images && variant.images.length > 0) { %>
                      <% variant.images.forEach(img => { %>
                        <img 
                          class="deal-image"
                          src="<%= img.url %>" 
                          alt="Variant Image"
                        />
                      <% }); %>
                    <% } else { %>
                      No images
                    <% } %>
                  </td>
                  <td><%= variant.total %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
          
          <!-- Show shipping info once, if it exists (assuming same shipping for entire purchase) -->
          <% const firstVariant = data.source_info[0].variant; %>
          <% if (firstVariant && firstVariant.shipping_address) { 
               const addr = firstVariant.shipping_address; 
          %>
            <div class="info-row section-title">Shipping Address</div>
            <div><%= addr.city %>, <%= addr.state %>, <%= addr.postcode %>, <%= addr.country?.name %></div>
            <div><%= addr.building %></div>
            <% /* Name handling, if you have data structured for kana/kanji or basic fields */ %>
            <% if (addr.name && addr.name.first_name) { %>
              <div>
                Recipient: <%= addr.name.first_name %> <%= addr.name.last_name %>
              </div>
            <% } %>
          <% } %>
        <% } else { %>
          <div class="gray-text">No purchased items found for BUYNOW.</div>
        <% } %>
        
      <% } else { %>
        <!-- For FUNDRAISER_FORM, RAFFLE, AUCTION, we can still handle source_info, 
             but typically it's a single or null. Adjust as needed. -->
        <div class="section-title">Donation Source Info</div>
        <% 
          // Could be an array or a single object or null
          if (!data.source_info) { 
        %>
          <div class="gray-text">No source info available.</div>
        <% } else if (Array.isArray(data.source_info) && data.source_info.length > 0) { %>
          <% data.source_info.forEach((item) => { %>
            <div class="info-row">
              <span class="info-label">Name:</span> <%= item.name %>
            </div>
            <!-- If there's shipping_address or other details, show them here -->
            <% if (item.shipping_address) { 
                 const addr = item.shipping_address;
            %>
              <div class="info-row">
                <span class="info-label">Shipping City:</span> <%= addr.city %>
              </div>
              <!-- etc. -->
            <% } %>
          <% }); %>
        <% } else if (typeof source_info === 'object') { %>
          <div class="info-row">
            <span class="info-label">Name:</span> <%= data.source_info.name || 'N/A' %>
          </div>
          <% if (data.source_info.shipping_address) {
               const addr = data.source_info.shipping_address;
          %>
            <div class="info-row">
              <span class="info-label">Shipping City:</span> <%= addr.city %>
            </div>
          <% } %>
        <% } %>
      <% } %>
      
      <div class="subtotal-section">
        <table>
          <tbody>
            <tr>
              <td>Deal Amount</td>
              <td><%= data.deal_amount || 'N/A' %></td>
            </tr>
            <tr>
              <td>Total Points</td>
              <td><%= data.total_points || 'N/A' %></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="footer-section">
        <%- include('./partials/footer'); %>
      </div>
    </div>
  </body>
</html>